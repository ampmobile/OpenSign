:{
    # -------------------------
    # API (strip /api)
    # -------------------------
    handle_path /api/* {
        reverse_proxy opensign-backAPI.railway.internal:8080
    }

    # -------------------------
    # PDF / files (NO strip)
    # -------------------------
    handle /app/files/* {
        header {
            Access-Control-Allow-Origin *
            Access-Control-Allow-Methods "GET, OPTIONS"
            Access-Control-Allow-Headers "*"
        }
        reverse_proxy opensign-backAPI.railway.internal:8080
    }

    # -------------------------
    # Frontend (Next.js)
    # SAME CONTAINER
    # -------------------------
    handle {
        reverse_proxy localhost:3000
    }
}
