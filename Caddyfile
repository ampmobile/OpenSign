:{$PORT} {

	# API -> backend
	handle_path /api/app/* {
		rewrite * /app{path}
		reverse_proxy backopensign.railway.internal:8080
	}

	# ✅ Parse file URLs often come out as /files/* (NOT /app/files/*)
	handle_path /files/* {
		rewrite * /app/files{path}
		reverse_proxy backopensign.railway.internal:8080
	}

	# Files/PDF (direct)
	handle /app/files* {
		reverse_proxy backopensign.railway.internal:8080
	}

	# Everything else -> frontend
	handle {
		reverse_proxy fe-open-sign.railway.internal:8080
	}
}
