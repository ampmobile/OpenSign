:${PORT} {

  # API -> backend (strip /api)
  handle_path /api/* {
    reverse_proxy backopensign.railway.internal:8080
  }

  # Static/PDF files -> backend (DO NOT strip)
  handle /app/files/* {
    reverse_proxy backopensign.railway.internal:8080
  }

  # Everything else -> frontend
  handle {
    reverse_proxy fe-open-sign.railway.internal:3000
  }
}
