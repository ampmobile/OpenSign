:{$PORT} {

  # API -> backend (strip /api)
  handle_path /api/* {
    reverse_proxy backopensign.railway.internal:8080
  }

  # Files/PDF -> backend (strip /app/files)
  handle_path /app/files/* {
    header {
      Access-Control-Allow-Origin "*"
      Access-Control-Allow-Methods "GET, OPTIONS"
      Access-Control-Allow-Headers "*"
    }
    reverse_proxy backopensign.railway.internal:8080
  }

  # Everything else -> frontend
  handle {
    reverse_proxy fe-open-sign.railway.internal:8080
  }
}
