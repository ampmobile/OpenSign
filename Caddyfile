:{$PORT}

# API -> backend
handle_path /api/* {
  reverse_proxy backopensign.railway.internal:8080
}

# Files -> backend (DON'T use handle_path here, keep full path)
handle /app/files/* {
  reverse_proxy backopensign.railway.internal:8080
}

# Everything else -> frontend
handle {
  reverse_proxy fe-open-sign.railway.internal:8000
}
