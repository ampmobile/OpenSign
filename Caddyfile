:{$PORT}

encode gzip

# API -> backAPI (strip /api so /api/app/... becomes /app/...)
handle_path /api/* {
  reverse_proxy openSign-backAPI:8080
}

# Files -> backAPI (so PDFs/images come from the backend)
handle /files/* {
  reverse_proxy openSign-backAPI:8080
}

# Everything else -> frontend
handle {
  reverse_proxy front-end-OpenSign:8080
}
