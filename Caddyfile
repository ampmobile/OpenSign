:{$PORT} {

  # API -> backend (strip /api)
  handle_path /api/* {
    reverse_proxy backopensign.railway.internal:8080
  }

  # Files/PDF -> backend (DO NOT STRIP PATH)
  handle /app/files/* {
    reverse_proxy backopensign.railway.internal:8080
  }

  # Everything else -> frontend (Vite preview)
  handle {
    reverse_proxy fe-open-sign.railway.internal:{$FRONTEND_PORT}
  }
}
