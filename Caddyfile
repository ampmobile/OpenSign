:{$PORT} {

  # API -> backend service
  handle_path /api/* {
    reverse_proxy opensign-backapi.railway.internal:8080
  }

  # Files/PDF -> backend (no strip)
  handle /app/files/* {
    reverse_proxy opensign-backapi.railway.internal:8080
  }

  # Everything else -> local Next.js
  handle {
    reverse_proxy localhost:3000
  }
}
