:{$PORT} {

	# --------------------
	# API (strip /api)
	# --------------------
	handle_path /api/* {
		reverse_proxy opensign-backAPI.railway.internal:8080
	}

	# --------------------
	# PDF / file access (NO path stripping)
	# --------------------
	handle /app/files/* {
		header {
			Access-Control-Allow-Origin  *
			Access-Control-Allow-Methods "GET, OPTIONS"
			Access-Control-Allow-Headers "*"
		}
		reverse_proxy opensign-backAPI.railway.internal:8080
	}

	# --------------------
	# FRONTEND (same service)
	# --------------------
	handle {
		reverse_proxy localhost:3000
	}
}
