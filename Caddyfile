:{$PORT} {

    # API (strip /api)
    handle_path /api/* {
        reverse_proxy opensign-backapi.railway.internal:8080
    }

    # PDF / file access (DO NOT strip path)
    handle /app/files/* {
        header {
            Access-Control-Allow-Origin *
            Access-Control-Allow-Methods "GET, OPTIONS"
            Access-Control-Allow-Headers "*"
        }
        reverse_proxy opensign-backapi.railway.internal:8080
    }

    # Frontend (Next.js)
    handle {
        reverse_proxy frontend-opensign.railway.internal:3000
    }
}
