:${PORT} {

  # API -> backend (strip /api)
  handle_path /api/* {
    reverse_proxy backopensign.railway.internal:8080 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto {http.request.scheme}
    }
  }

  # Files/PDFs -> backend (DO NOT strip path)
  handle /app/files* {
    reverse_proxy backopensign.railway.internal:8080 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto {http.request.scheme}
    }
  }

  # Everything else -> frontend
  handle {
    reverse_proxy fe-open-sign.railway.internal:8080
  }
}
